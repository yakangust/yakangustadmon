---
let mensajeRespuesta = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const nombre = data.get('nombre');
    const email = data.get('email');
    const mensaje = data.get('mensaje');

    const res = await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${import.meta.env.RESEND_API_KEY}`,
      },
      body: JSON.stringify({
        from: 'onboarding@resend.dev',
        to: 'tu-correo@dominio.com',
        subject: `Nuevo mensaje de contacto de ${nombre}`,
        html: `<p><strong>Nombre:</strong> ${nombre}</p>
               <p><strong>Email:</strong> ${email}</p>
               <p><strong>Mensaje:</strong> ${mensaje}</p>`,
      }),
    });

    if (res.ok) {
      mensajeRespuesta = '¡Mensaje enviado con éxito!';
    } else {
      mensajeRespuesta = 'Error al enviar el mensaje. Inténtalo de nuevo.';
    }
  } catch (e) {
    mensajeRespuesta = 'Error en el servidor.';
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contacto / Asesoría</title>
</head>
<body class="bg-gray-100 text-gray-900 font-sans">
  <main class="container mx-auto p-4 max-w-lg mt-10 bg-white shadow-md rounded-lg">
    <h1 class="text-2xl font-bold mb-4 text-center">Contacto / Asesoría Gratuita</h1>

    {mensajeRespuesta && (
      <p class="mb-4 p-2 bg-emerald-100 text-emerald-700 rounded text-center font-semibold">
        {mensajeRespuesta}
      </p>
    )}

    <form method="POST" class="flex flex-col gap-4">
      <div>
        <label class="block mb-1 font-medium">Nombre:</label>
        <input type="text" name="nombre" required class="w-full border border-gray-300 p-2 rounded text-black" />
      </div>

      <div>
        <label class="block mb-1 font-medium">Correo electrónico:</label>
        <input type="email" name="email" required class="w-full border border-gray-300 p-2 rounded text-black" />
      </div>

      <div>
        <label class="block mb-1 font-medium">Mensaje o consulta:</label>
        <textarea name="mensaje" rows="4" required class="w-full border border-gray-300 p-2 rounded text-black"></textarea>
      </div>

      <button type="submit" class="bg-emerald-600 text-white font-bold py-2 px-4 rounded hover:bg-emerald-700 transition-colors">
        Enviar Mensaje
      </button>
    </form>
  </main>
</body>
</html>

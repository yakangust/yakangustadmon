---
const commonStyles = `
  @import url('https://fonts.googleapis.com/css2?family=Lobster&display=swap');

  :root {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --text: #f8fafc;
    --accent: #38bdf8;
    --muted: #94a3b8;
    --input-bg: #0f172a;
    --border: #334155;
    --hover-green: #22c55e;
  }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }
  .container {
    background-color: var(--card-bg);
    padding: 30px;
    border-radius: 12px;
    border: 1px solid var(--border);
    max-width: 500px;
    width: 100%;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  }
  h1 {
    font-family: 'Lobster', cursive;
    color: var(--accent);
    margin-bottom: 20px;
    text-align: center;
  }
  .form-group {
    margin-bottom: 15px;
  }
  label {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  input, select, textarea {
    width: 100%;
    padding: 10px;
    background-color: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    box-sizing: border-box;
  }
  button {
    width: 100%;
    padding: 12px;
    background-color: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  button:hover {
    background-color: var(--hover-green);
    color: white;
  }
  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .mensaje-estado {
    display: none;
    margin-top: 15px;
    padding: 12px;
    border-radius: 6px;
    font-weight: bold;
    text-align: center;
  }
`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contacto - Yakangustc S.A.S</title>
  <style set:html={commonStyles}></style>
</head>
<body>
  <div class="container">
    <h1>Contacto</h1>

    <form id="form-contacto">
      <div class="form-group">
        <label for="nombre">Nombre completo</label>
        <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre" />
      </div>

      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" required placeholder="tu@correo.com" />
      </div>

      <div class="form-group">
        <label for="servicio">Servicio / Asunto</label>
        <input type="text" id="servicio" name="servicio" placeholder="Asunto o servicio de interés" />
      </div>

      <div class="form-group">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Escribe tu mensaje aquí..."></textarea>
      </div>

      <button type="submit" id="btn-enviar">Enviar mensaje</button>

      <!-- Alerta dinámica -->
      <div id="mensaje-estado" class="mensaje-estado"></div>
    </form>
  </div>

  <script>
    const form = document.getElementById('form-contacto') as HTMLFormElement;
    const estado = document.getElementById('mensaje-estado');
    const btn = document.getElementById('btn-enviar') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (btn) btn.disabled = true;
      if (estado) {
        estado.style.display = 'block';
        estado.style.backgroundColor = '#0284c7';
        estado.style.color = '#ffffff';
        estado.innerHTML = '⏳ Enviando mensaje...';
      }

      const formData = new FormData(form);

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          body: formData,
        });

        if (res.ok) {
          if (estado) {
            estado.style.backgroundColor = '#16a34a';
            estado.style.color = '#ffffff';
            estado.innerHTML = '✅ ¡Mensaje enviado con éxito!';
          }
          form.reset();

          // Espera 2.5 segundos mostrando la palomita y redirige a la raíz
          setTimeout(() => {
            window.location.href = '/';
          }, 2500);

        } else {
          throw new Error('Error en la respuesta del servidor');
        }
      } catch (err) {
        if (estado) {
          estado.style.backgroundColor = '#dc2626';
          estado.style.color = '#ffffff';
          estado.innerHTML = '❌ Hubo un error al enviar el mensaje. Inténtalo de nuevo.';
        }
        if (btn) btn.disabled = false;
      }
    });
  </script>
</body>
</html>

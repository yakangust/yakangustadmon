---
const url = new URL(Astro.request.url);
const status = url.searchParams.get('envio');

const commonStyles = `
  @import url('https://fonts.googleapis.com/css2?family=Lobster&display=swap');

  :root {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --text: #f8fafc;
    --accent: #38bdf8;
    --muted: #94a3b8;
    --input-bg: #0f172a;
    --border: #334155;
    --hover-green: #22c55e;
  }
  body { 
    font-family: system-ui, -apple-system, sans-serif; 
    background-color: var(--bg); 
    color: var(--text);
    margin: 0;
    padding: 2rem 1rem;
  }
  .container { max-width: 800px; margin: 0 auto; }
  header { margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
  .header-top { display: flex; justify-content: space-between; align-items: center; }
  .brand { font-family: 'Lobster', cursive; font-size: 2rem; color: var(--accent); margin: 0; }
  
  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 2rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
  }
  .form-group { margin-bottom: 1.5rem; }
  label { display: block; margin-bottom: 0.5rem; color: var(--muted); font-size: 0.9rem; }
  input, select, textarea {
    width: 100%;
    padding: 0.75rem;
    background-color: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--text);
    font-size: 1rem;
    box-sizing: border-box;
  }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  button {
    background-color: var(--accent);
    color: #000;
    font-weight: bold;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    width: 100%;
    font-size: 1rem;
    transition: background-color 0.2s;
  }
  button:hover { background-color: var(--hover-green); color: #fff; }
  .alert-success {
    background-color: #166534;
    color: #4ade80;
    padding: 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    border: 1px solid #22c55e;
    text-align: center;
  }
`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contacto - Yakangust C S.A.S</title>
    <style set:html={commonStyles}></style>
  </head>
  <body>
    <div class="container">
      <header>
        <div class="header-top">
          <h1 class="brand">Yakangust C S.A.S</h1>
          <a href="/" style="color: var(--accent); text-decoration: none;">&larr; Volver</a>
        </div>
      </header>

      <main class="card">
        <h2>Contacto</h2>
        <p style="color: var(--muted); margin-bottom: 2rem;">
          Envíanos un mensaje y nos pondremos en contacto contigo a la brevedad.
        </p>

        {status === 'ok' && (
          <div class="alert-success">
            ¡Tu mensaje ha sido enviado exitosamente! Nos pondremos en contacto pronto.
          </div>
        )}

        <form action="/api/contacto" method="POST">
          <div class="form-group">
            <label for="nombre">Nombre Completo</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre..." />
          </div>

          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com" />
          </div>

          <div class="form-group">
            <label for="servicio">Servicio de interés</label>
            <select id="servicio" name="servicio" required>
              <option value="" disabled selected>Selecciona una opción...</option>
              <option value="Asesoría Fiscal">Asesoría Fiscal</option>
              <option value="Auditoría">Auditoría</option>
              <option value="Contabilidad General">Contabilidad General</option>
              <option value="Otro">Otro</option>
            </select>
          </div>

          <div class="form-group">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Escribe tu mensaje aquí..."></textarea>
          </div>

          <button type="submit">Enviar Mensaje</button>
        </form>
      </main>
    </div>
  </body>
</html>
